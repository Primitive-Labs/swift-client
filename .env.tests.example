TEST_HTTP_URL=http://localhost:8787
TEST_WS_URL=ws://localhost:8787
# Super-admin JWT for the local dev server.
#
# You normally DON'T need to set this: the Swift test suite mints its own
# short-lived super-admin token at setup time, signed with TEST_JWT_SECRET
# (see swift-client/Tests/JsBaoClientTests/Setup/TestConfig.swift). Only set
# TEST_SUPERADMIN_JWT to override with a hand-minted token.
#
# Mint one manually with: node -e "const jwt = require('jsonwebtoken'); console.log(jwt.sign({adminId:'YOUR_ADMIN_ID',email:'you@example.com',name:'Your Name',role:'super-admin',isSuperAdmin:true,appCreationLimit:50,type:'admin',enableTestFeatures:true},'test-jwt-secret-only-for-agents',{expiresIn:'24h'}))"
TEST_SUPERADMIN_JWT=

# HS256 secret the dev server validates admin JWTs with. Must match the
# server's JWT_SECRET (see the repo root .dev.vars). Defaults to this value
# when unset, so self-minting works out of the box.
TEST_JWT_SECRET=test-jwt-secret-only-for-agents
