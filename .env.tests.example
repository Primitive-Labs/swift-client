TEST_HTTP_URL=http://localhost:8787
TEST_WS_URL=ws://localhost:8787
# Super-admin for the local dev server.
#
# You normally DON'T need to set either: with both empty, the Swift test suite
# asks the local dev server's test-only POST /__test__/admin/ensure-super-admin
# route (X-Test-Auth: TEST_ADMIN_TOKEN, default local-test-secret) for its own
# super-admin row and signs a token for it with TEST_JWT_SECRET (see
# swift-client/Tests/JsBaoClientTests/Setup/TestConfig.swift). The server
# refuses a token whose adminId names no admin row, so a hand-minted token
# must name an existing one.
#
# TEST_SUPERADMIN_JWT: a super-admin token, used as is.
# TEST_SUPERADMIN_EMAIL: an existing admin's email; the suite signs an
#   email-only token for it.
TEST_SUPERADMIN_JWT=
TEST_SUPERADMIN_EMAIL=

# HS256 secret the dev server validates admin JWTs with. Must match the
# server's JWT_SECRET (see the repo root .dev.vars). Defaults to this value
# when unset, so the default setup works out of the box.
TEST_JWT_SECRET=test-jwt-secret-only-for-agents
